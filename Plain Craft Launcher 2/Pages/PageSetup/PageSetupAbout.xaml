<local:MyPageRight
    x:Class="PCL.PageSetupAbout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:PCL.Core.App;assembly=PCL.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PCL"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DataContext="{Binding Source={x:Static app:Basics.Metadata}}"
    PanScroll="{Binding ElementName=PanBack}"
    RenderOptions.BitmapScalingMode="LowQuality">
    <local:MyScrollViewer
        x:Name="PanBack"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="PanMain"
            Margin="25,10"
            Grid.IsSharedSizeScope="True">

            <!-- 开发者 -->
            <local:MyCard Margin="0,15" Title="梦之韵Pro 开发者">
                <Grid Margin="21,40,21,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45" />
                        <RowDefinition Height="45" />
                        <RowDefinition Height="45" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <Image RenderOptions.BitmapScalingMode="LowQuality"
                        Grid.Row="0"
                        Margin="3"
                        Source="/Plain Craft Launcher 2;component/Images/Heads/me.png">
                        <Image.Clip>
                            <EllipseGeometry Center="17 17" RadiusX="17" RadiusY="17" />
                        </Image.Clip>
                    </Image>
                    <local:MyListItem
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="-5,0,15,0"
                        Info="梦之韵Pro 开发者 · 服务器技术负责"
                        IsHitTestVisible="False"
                        Title="Catkinr" />
                    <local:MyButton
                        Grid.Row="0"
                        Grid.Column="2"
                        Height="35"
                        local:CustomEventService.EventData="https://www.camzy.tech"
                        local:CustomEventService.EventType="OpenUrl"
                        Text="官网" />

                    <Image RenderOptions.BitmapScalingMode="LowQuality"
                        Grid.Row="1"
                        Margin="3"
                        Source="/Plain Craft Launcher 2;component/Images/Heads/friend.png">
                        <Image.Clip>
                            <EllipseGeometry Center="17 17" RadiusX="17" RadiusY="17" />
                        </Image.Clip>
                    </Image>
                    <local:MyListItem
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="-5,0,15,0"
                        Info="梦之韵Pro 开发者 · 服务器技术支持"
                        IsHitTestVisible="False"
                        Title="liminality" />
                    <local:MyButton
                        Grid.Row="1"
                        Grid.Column="2"
                        Height="35"
                        local:CustomEventService.EventData="https://t.me/maoxinhe"
                        local:CustomEventService.EventType="OpenUrl"
                        Text="联系方式" />

                    <Image RenderOptions.BitmapScalingMode="LowQuality"
                        Grid.Row="2"
                        Margin="3"
                        Source="/Plain Craft Launcher 2;component/Images/Heads/ai.png">
                        <Image.Clip>
                            <EllipseGeometry Center="17 17" RadiusX="17" RadiusY="17" />
                        </Image.Clip>
                    </Image>
                    <local:MyListItem
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="-5,0,15,0"
                        Info="AI 协作开发 · 由梦之韵云端驱动"
                        IsHitTestVisible="False"
                        Title="AI 伙伴" />
                    <local:MyButton
                        Grid.Row="2"
                        Grid.Column="2"
                        Height="35"
                        local:CustomEventService.EventData="https://github.com/maoxinhe/mzy-pro"
                        local:CustomEventService.EventType="OpenUrl"
                        Text="查看源代码" />
                </Grid>
            </local:MyCard>

            <!-- 更新日志 -->
            <local:MyCard Margin="0,15" Title="更新日志">
                <StackPanel Margin="21,40,21,20">
                    <TextBlock Margin="0,0,0,10" FontSize="14" FontWeight="SemiBold" Text="v2.15.31 (2026-10-05)" />
                    <TextBlock Margin="0,0,0,5" Text="• 错误自动上报云端AI分析，邮件通知开发者" Foreground="Gray" />
                    <TextBlock Margin="0,0,0,15" FontSize="14" FontWeight="SemiBold" Text="v2.15.30 (2026-10-05)" />
                    <TextBlock Margin="0,0,0,5" Text="• 云端智谱AI判断更新，启动器上报版本自动检测" Foreground="Gray" />
                    <TextBlock Margin="0,0,0,15" FontSize="14" FontWeight="SemiBold" Text="v2.15.29 (2026-10-05)" />
                    <TextBlock Margin="0,0,0,5" Text="• 修复版本号检测bug，发行商改为苏州梦之韵科技" Foreground="Gray" />
                    <TextBlock Margin="0,0,0,15" FontSize="14" FontWeight="SemiBold" Text="v2.15.28 (2026-10-05)" />
                    <TextBlock Margin="0,0,0,5" Text="• 淡粉色主题，樱花山黄昏背景" Foreground="Gray" />
                    <TextBlock Margin="0,0,0,15" FontSize="14" FontWeight="SemiBold" Text="v2.15.12 (2026-10-04)" />
                    <TextBlock Margin="0,0,0,5" Text="• 集成Yggdrasil离线登录，AI助手，论坛入口" Foreground="Gray" />
                </StackPanel>
            </local:MyCard>

            <!-- 软件信息 -->
            <local:MyCard Margin="0,15" Title="软件信息">
                <StackPanel Margin="21,40,21,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="软件名称" />
                        <TextBlock x:Name="ItemAboutPcl" Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Text="{Binding Name}" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="当前版本" />
                        <TextBlock x:Name="TextVersion" Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="版权" />
                        <TextBlock Grid.Column="1" Grid.Row="4" VerticalAlignment="Center" Text="梦之韵团队 · 基于 PCL-CE 二次开发" />
                        <local:MyButton
                            Grid.Row="0"
                            Grid.Column="3"
                            Height="35"
                            local:CustomEventService.EventData="https://www.camzy.tech"
                            local:CustomEventService.EventType="OpenUrl"
                            Text="官网" />
                        <local:MyButton
                            Grid.Row="2"
                            Grid.Column="3"
                            Height="35"
                            local:CustomEventService.EventData="https://player.camzy.uno"
                            local:CustomEventService.EventType="OpenUrl"
                            Text="玩家门户" />
                        <local:MyButton
                            Grid.Row="4"
                            Grid.Column="3"
                            Height="35"
                            local:CustomEventService.EventData="https://github.com/maoxinhe/mzy-pro/releases"
                            local:CustomEventService.EventType="OpenUrl"
                            Text="更新日志" />
                    </Grid>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="18"
                               Text="梦之韵Pro 是专为梦之韵服务器打造的 PCL2 增强启动器。遇到问题请在玩家门户「工单」中反馈。" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>

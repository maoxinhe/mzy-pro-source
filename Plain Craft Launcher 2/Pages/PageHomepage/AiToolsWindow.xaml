<Window
    x:Class="PCL.AiToolsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="梦之韵Pro · AI 助手"
    Width="560"
    Height="620"
    MinWidth="420"
    MinHeight="400"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource ColorBrushBackground}"
    FontSize="13"
    ShowInTaskbar="False"
    ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            FontSize="18"
            FontWeight="Bold"
            Foreground="{DynamicResource ColorBrush1}"
            Text="梦之韵Pro · AI 助手" />

        <!-- 输入区 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="InQuestion"
                Grid.Column="0"
                Height="30"
                Padding="8,5"
                VerticalContentAlignment="Center"
                BorderBrush="{DynamicResource ColorBrushGray4}"
                Background="{DynamicResource ColorBrushWhite}"
                Foreground="{DynamicResource ColorBrush1}"
                Text="问我任何问题：报错、模组、服务器…"
                KeyDown="InQuestion_KeyDown" />
            <Button
                x:Name="BtnSend"
                Grid.Column="1"
                Width="76"
                Height="30"
                Margin="8,0,0,0"
                Content="发送"
                Background="{DynamicResource ColorBrushAccent}"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Click="BtnSend_Click" />
        </Grid>

        <!-- 工具按钮行 -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,8" VerticalAlignment="Top">
            <Button
                x:Name="BtnModCheck"
                Height="28"
                Margin="0,0,8,8"
                Padding="12,0"
                Content="模组冲突检测"
                Cursor="Hand"
                Background="#FFF0F4"
                BorderBrush="#FFE0B2"
                Foreground="#B3665C"
                Click="BtnModCheck_Click" />
            <Button
                x:Name="BtnMemAdvice"
                Height="28"
                Margin="0,0,8,8"
                Padding="12,0"
                Content="内存优化建议"
                Cursor="Hand"
                Background="#FFF0F4"
                BorderBrush="#FFE0B2"
                Foreground="#B3665C"
                Click="BtnMemAdvice_Click" />
            <Button
                x:Name="BtnClear"
                Height="28"
                Margin="0,0,8,8"
                Padding="12,0"
                Content="清空"
                Cursor="Hand"
                Click="BtnClear_Click" />
            <TextBlock
                x:Name="TxtStatus"
                VerticalAlignment="Center"
                Foreground="{DynamicResource ColorBrushGray4}"
                Text="" />
        </WrapPanel>

        <!-- 结果区 -->
        <Border
            Grid.Row="3"
            Background="{DynamicResource ColorBrushWhite}"
            BorderBrush="{DynamicResource ColorBrushGray4}"
            BorderThickness="1"
            CornerRadius="6">
            <TextBox
                x:Name="TxtResult"
                MinHeight="320"
                Margin="8"
                Padding="4"
                AcceptsReturn="True"
                IsReadOnly="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
                BorderThickness="0"
                Background="Transparent"
                Foreground="{DynamicResource ColorBrush1}"
                FontFamily="Microsoft YaHei UI"
                FontSize="13" />
        </Border>
    </Grid>
</Window>

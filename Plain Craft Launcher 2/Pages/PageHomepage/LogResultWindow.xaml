<Window
    x:Class="PCL.LogResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    Title="梦之韵Pro · AI 分析结果"
    Width="580"
    Height="520"
    MinWidth="420"
    MinHeight="320"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource ColorBrushBackground}"
    FontSize="13"
    ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            x:Name="TxtTitle"
            Margin="0,0,0,10"
            FontSize="17"
            FontWeight="Bold"
            Foreground="{DynamicResource ColorBrush1}"
            Text="AI 分析结果" />

        <Border
            Grid.Row="1"
            Background="{DynamicResource ColorBrushWhite}"
            BorderBrush="{DynamicResource ColorBrushGray4}"
            BorderThickness="1"
            CornerRadius="6">
            <TextBox
                x:Name="TxtContent"
                Margin="8"
                Padding="4"
                AcceptsReturn="True"
                IsReadOnly="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
                BorderThickness="0"
                Background="Transparent"
                Foreground="{DynamicResource ColorBrush1}"
                FontFamily="Microsoft YaHei UI"
                FontSize="13" />
        </Border>

        <Button
            Grid.Row="2"
            Width="90"
            Height="30"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Content="关闭"
            Background="{DynamicResource ColorBrushAccent}"
            Foreground="White"
            BorderThickness="0"
            Cursor="Hand"
            Click="BtnClose_Click" />
    </Grid>
</Window>

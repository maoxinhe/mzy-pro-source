<Window
    x:Class="PCL.SkinPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    Title="梦之韵Pro · 皮肤预览"
    Width="400"
    Height="480"
    MinWidth="350"
    MinHeight="400"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource ColorBrushBackground}"
    FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 搜索栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox
                x:Name="TxtName"
                Width="200"
                Height="32"
                Margin="0,0,8,0"
                VerticalContentAlignment="Center"
                Tag="输入MC名字..."
                Text="{Binding InputName, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                x:Name="BtnSearch"
                Width="80"
                Height="32"
                Content="查询"
                Background="{DynamicResource ColorBrushAccent}"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Click="BtnSearch_Click" />
        </StackPanel>

        <!-- 皮肤显示区 -->
        <Border
            Grid.Row="1"
            Background="{DynamicResource ColorBrushWhite}"
            BorderBrush="{DynamicResource ColorBrushGray4}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image
                    x:Name="ImgSkin"
                    Width="120"
                    Height="120"
                    Stretch="Uniform"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="TxtStatus"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Text="输入玩家名字查询皮肤"
                    Foreground="{DynamicResource ColorBrushGray3}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
